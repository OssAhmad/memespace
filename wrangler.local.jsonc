{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memespace-local",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "memespace", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "vars": {
    "LOCAL_AUTH": "true",
    "AUTH_SECRET": "local-development-only-memespace-do-not-use-in-production",
    "OWNER_EMAIL": "owner@example.test"
  }
}
