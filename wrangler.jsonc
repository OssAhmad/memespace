{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "winter-violet-342b",
  "account_id": "2eff40a2255f98ece1b44ccb4cc0f22e",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "memespace",
      "database_id": "106ec07e-7b29-440f-b133-d1f6b894b927",
      "migrations_dir": "migrations"
    },
    {
      "binding": "memespace",
      "database_name": "memespace",
      "database_id": "106ec07e-7b29-440f-b133-d1f6b894b927"
    }
  ]
}
